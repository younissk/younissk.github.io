---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, AUTHOR, RSS_PATH } from '../consts';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image. */
  ogImage?: string;
  noindex?: boolean;
  /** Override the canonical URL. Defaults to the current path on SITE_URL. */
  canonical?: string;
  /** 'article' for posts, 'website' for everything else. */
  ogType?: 'website' | 'article';
  /** ISO date, emitted as article:published_time when ogType is 'article'. */
  publishedTime?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage,
  noindex = false,
  canonical,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const fullTitle = title.includes(SITE_TITLE) ? title : `${title} — ${SITE_TITLE}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).href;

/* ---------------------------------------------------------------------------
   Social preview image.

   The cards in public/og/ are generated by `npm run og` and committed; the
   build only reads them as static files. Each is named after its route with
   the slashes turned into hyphens, so /work/abk-document-ai/ resolves to
   /og/work-abk-document-ai.png. Pages with no card of their own — tag listings,
   anything added since the last run — fall back to the site-wide one rather
   than pointing a scraper at a 404.

   The glob is resolved at build time and never imported, so this costs nothing
   at runtime; it exists purely to know which filenames are actually there.
   --------------------------------------------------------------------------- */
const OG_FALLBACK = '/og/index.png';
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;

const ogFiles = new Set(
  Object.keys(import.meta.glob('/public/og/*.png')).map((path) => path.split('/').pop()),
);

function cardForRoute(pathname: string): string {
  const route = pathname.replace(/^\/+|\/+$/g, '');
  const name = route === '' ? 'index' : route.replace(/\//g, '-');
  return ogFiles.has(`${name}.png`) ? `/og/${name}.png` : OG_FALLBACK;
}

// Absolute, always: most scrapers ignore a relative og:image outright.
const imageUrl = new URL(ogImage ?? cardForRoute(Astro.url.pathname), SITE_URL).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR.name,
  url: SITE_URL,
  jobTitle: AUTHOR.role,
  knowsAbout: [
    'Retrieval-augmented generation',
    'Large language models',
    'Backend engineering',
    'Information retrieval',
  ],
  sameAs: [AUTHOR.github, AUTHOR.linkedin, AUTHOR.youtube, AUTHOR.huggingface],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<meta name="theme-color" content="#0d0d0f" />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} — Writing`}
  href={new URL(RSS_PATH, SITE_URL).href}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
