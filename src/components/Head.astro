---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, AUTHOR, RSS_PATH } from '../consts';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image. */
  ogImage?: string;
  noindex?: boolean;
  /** Override the canonical URL. Defaults to the current path on SITE_URL. */
  canonical?: string;
  /** 'article' for posts, 'website' for everything else. */
  ogType?: 'website' | 'article';
  /** ISO date, emitted as article:published_time when ogType is 'article'. */
  publishedTime?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage,
  noindex = false,
  canonical,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const fullTitle = title.includes(SITE_TITLE) ? title : `${title} — ${SITE_TITLE}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).href;
const imageUrl = ogImage ? new URL(ogImage, SITE_URL).href : undefined;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR.name,
  url: SITE_URL,
  jobTitle: AUTHOR.role,
  knowsAbout: [
    'Retrieval-augmented generation',
    'Large language models',
    'Backend engineering',
    'Information retrieval',
  ],
  sameAs: [AUTHOR.github, AUTHOR.linkedin, AUTHOR.youtube],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0d0d0f" media="(prefers-color-scheme: dark)" />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_TITLE} — Writing`}
  href={new URL(RSS_PATH, SITE_URL).href}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content="en_GB" />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
