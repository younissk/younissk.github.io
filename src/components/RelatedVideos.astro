---
/**
 * The videos about a project, shown as real cards rather than another button.
 *
 * A "Video" link in a row of eight identical buttons is not an invitation to
 * watch anything. The thumbnail is; and the thumbnails are already in the repo.
 */
import { videoHref, formatDuration, type VideoRecord } from '../lib/videos';

interface Props {
  videos: readonly VideoRecord[];
  class?: string;
}

const { videos, class: className } = Astro.props;
const nf = new Intl.NumberFormat('en-US');
---

{
  videos.length > 0 && (
    <ul class:list={['related-videos', className]}>
      {videos.map((video) => {
        const thumb = (video.thumbnails.medium ?? video.thumbnails.default ?? video.thumbnails.high)?.url;
        const duration = formatDuration(video.duration);
        const date = video.publishedAt.slice(0, 10);
        return (
          <li>
            <a class="related-video" href={videoHref(video.id)}>
              <span class="related-video-shot">
                {thumb && (
                  <img src={thumb} alt="" width="320" height="180" loading="lazy" decoding="async" />
                )}
                <span class="related-video-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
                    <path d="M8 5.5v13l11-6.5L8 5.5Z" />
                  </svg>
                </span>
                {duration && <span class="related-video-duration">{duration}</span>}
              </span>

              <span class="related-video-body">
                <span class="related-video-title">{video.title}</span>
                <span class="related-video-meta">
                  <time datetime={date}>{date}</time>
                  {video.viewCount != null && <span>{nf.format(video.viewCount)} views</span>}
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .related-videos {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .related-video {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 0 1rem;
    align-items: center;
    color: var(--c-ink);
  }

  .related-video-shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--c-surface-2);
    border: 2px solid var(--c-border);
    transition: border-color 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .related-video-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.85) brightness(0.8);
    transition: filter 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .related-video:hover .related-video-shot img,
  .related-video:focus-visible .related-video-shot img {
    filter: none;
  }

  .related-video:hover .related-video-shot,
  .related-video:focus-visible .related-video-shot {
    border-color: var(--c-accent);
  }

  .related-video-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--c-ink);
  }

  .related-video-play svg {
    width: 1.6rem;
    height: 1.6rem;
    background-color: rgb(0 0 0 / 0.55);
    padding: 0.35rem 0.3rem 0.35rem 0.4rem;
  }

  .related-video:hover .related-video-play svg,
  .related-video:focus-visible .related-video-play svg {
    color: #000;
    background-color: var(--c-accent);
  }

  .related-video-duration {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.1rem 0.35rem;
    background-color: #000;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
  }

  .related-video-title {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .related-video:hover .related-video-title,
  .related-video:focus-visible .related-video-title {
    color: var(--c-accent);
  }

  .related-video-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.75rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--c-ink-faint);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 30rem) {
    .related-video { grid-template-columns: 1fr; gap: 0.6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-video-shot img,
    .related-video-shot { transition: none; }
  }
</style>
