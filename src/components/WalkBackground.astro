---
/**
 * Four self-avoiding walks filling a grid.
 *
 * Descended from younissk.github.io/p5-projects/Self avoiding walk, which is a
 * single walker doing a depth-first walk with backtracking. This runs four on
 * ONE shared grid, so they are self-avoiding and also avoid each other: a cell
 * anyone has visited is a wall forever.
 *
 * There is no goal. An earlier version raced them to one and it was over in a
 * second, because a walker that heads straight for a target does not explore.
 * Now they try to cover ground, and the interesting behaviour is the
 * competition for space: they carve each other's territory away, seal each
 * other into pockets, and eventually suffocate.
 *
 * Move choice is Warnsdorff's rule, the heuristic from the knight's tour: step
 * to the neighbour that has the FEWEST free neighbours of its own. That makes a
 * walker hug walls and its own trail, consume the awkward cells before they
 * become isolated, and survive far longer than a random step would. A small
 * chance of ignoring the rule keeps the shapes from being identical each round.
 *
 * A walker with nowhere to go retires. Its path stays exactly where it is —
 * still owned, so nobody may cross it, and still drawn, faded back to a
 * texture — and a replacement spawns elsewhere. So the picture accumulates:
 * the grid genuinely fills over about twenty seconds, holds for a beat, and
 * starts again.
 *
 * It did not always. Retiring a walker used to hand its whole territory back,
 * which erased as fast as the other three drew. Measured on the live site,
 * coverage peaked near 2% and then fell. The reset below was unreachable and
 * the whole simulation was, in practice, invisible.
 *
 * Written against the raw 2D canvas rather than p5. p5.min.js is about a
 * megabyte, and this is the background of the most-visited page on a site whose
 * whole architecture is that nothing third-party loads at runtime.
 *
 * It is a background, so it yields: it stops when the tab is hidden, stops when
 * scrolled out of view, and renders a single finished frame instead of
 * animating when the visitor asks for reduced motion.
 */
---

<canvas id="walk-bg" aria-hidden="true"></canvas>

<style>
  /*
   * The frame is the canvas's own border rather than a separate element. That
   * keeps the simulation visibly inside it, and avoids stacking a fixed frame
   * between a z-index:-1 canvas and unpositioned text.
   */
  #walk-bg {
    position: fixed;
    top: var(--frame-inset);
    left: var(--frame-inset);
    /*
     * Sized explicitly, not with `inset`. A canvas is a REPLACED element, so
     * with all four offsets set and width:auto it takes its intrinsic 300x150
     * and parks in the corner instead of stretching. That is what happened the
     * first time this frame was added.
     */
    width: calc(100vw - 2 * var(--frame-inset));
    height: calc(100svh - 2 * var(--frame-inset));
    box-sizing: border-box;
    z-index: -1;
    display: block;
    border: var(--frame-width) solid var(--c-border-strong);
    pointer-events: none;
  }
</style>

<script is:inline>
  (() => {
    const canvas = document.getElementById('walk-bg');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const SPACING = 24;
    const STEPS_PER_FRAME = 1;
    /* Was 9fps, which drew about 36 cells a second. Combined with the bug
       below, coverage peaked near 2% and then went DOWN. Measured on the live
       site: 1.98% at three seconds, 1.85% ten seconds later. Nobody ever saw
       this thing draw anything. */
    const FRAME_MS = 1000 / 24;
    /* How often a walker ignores Warnsdorff and steps at random. Zero makes
       every round look the same; too much and they strangle themselves early. */
    const CHAOS = 0.12;

    /* Two tiers. The walker that is moving right now is bright enough to
       follow; everything it has already laid down fades back to a texture.
       That is what keeps the accumulated picture from fighting the text, and
       it reads as depth rather than as one flat wash. */
    const LIVE = [
      'rgba(255, 228, 0, 0.92)',
      'rgba(255, 255, 255, 0.72)',
      'rgba(255, 255, 255, 0.55)',
      'rgba(255, 228, 0, 0.62)',
    ];
    const TRAIL = [
      'rgba(255, 228, 0, 0.30)',
      'rgba(255, 255, 255, 0.24)',
      'rgba(255, 255, 255, 0.17)',
      'rgba(255, 228, 0, 0.20)',
    ];

    let cols = 0;
    let rows = 0;
    let owner = new Int8Array(0); // 0 free, 1..4 = walker id
    let walkers = [];
    /* Finished paths. THE fix: these used to be thrown away. */
    let trails = [];
    let filled = 0;
    let holdUntil = 0;
    let raf = 0;
    let last = 0;
    let running = false;

    const idx = (x, y) => y * cols + x;
    const inBounds = (x, y) => x >= 0 && x < cols && y >= 0 && y < rows;

    function reset() {
      owner = new Int8Array(cols * rows);
      filled = 0;
      trails = [];

      walkers = [];
      for (let i = 0; i < 4; i++) {
        walkers.push({ id: i + 1, path: [], dead: false });
        respawn(walkers[i]);
      }
    }

    /** A free cell, or null when there is genuinely nowhere left. */
    function freeCell() {
      for (let tries = 0; tries < 300; tries++) {
        const x = Math.floor(Math.random() * cols);
        const y = Math.floor(Math.random() * rows);
        if (owner[idx(x, y)] === 0) return { x, y };
      }
      /* Random darts missed, so sweep. Cheap, and only runs when the grid is
         nearly full, which is exactly when darts stop working. */
      for (let i = 0; i < owner.length; i++) {
        if (owner[i] === 0) return { x: i % cols, y: Math.floor(i / cols) };
      }
      return null;
    }

    /**
     * Retire this walker's path and start a new one elsewhere.
     *
     * This used to free every cell the walker had taken, which is why the
     * drawing never accumulated: a walker seals itself in after roughly fifty
     * steps, and handing its whole territory back erased as much as the other
     * three were adding. The picture oscillated around 2% coverage forever.
     *
     * Now the path is kept — the cells stay owned, so later walkers route
     * around it, and it stays on screen as a dimmed trail. The grid genuinely
     * fills, which is what the reset at the end of tick() was always waiting
     * for and never got.
     */
    function respawn(w) {
      if (w.path.length > 1) trails.push({ id: w.id, path: w.path });

      const spot = freeCell();
      if (!spot) {
        w.path = [];
        w.dead = true;
        return;
      }
      owner[idx(spot.x, spot.y)] = w.id;
      filled++;
      w.path = [spot];
      w.dead = false;
    }

    function freeNeighbours(x, y) {
      let n = 0;
      if (inBounds(x + 1, y) && owner[idx(x + 1, y)] === 0) n++;
      if (inBounds(x - 1, y) && owner[idx(x - 1, y)] === 0) n++;
      if (inBounds(x, y + 1) && owner[idx(x, y + 1)] === 0) n++;
      if (inBounds(x, y - 1) && owner[idx(x, y - 1)] === 0) n++;
      return n;
    }

    function step(w) {
      if (w.dead) return;

      const head = w.path[w.path.length - 1];
      const options = [
        { x: head.x + 1, y: head.y },
        { x: head.x - 1, y: head.y },
        { x: head.x, y: head.y + 1 },
        { x: head.x, y: head.y - 1 },
      ].filter((n) => inBounds(n.x, n.y) && owner[idx(n.x, n.y)] === 0);

      if (options.length === 0) {
        /* Sealed in. It leaves its path behind and starts again elsewhere. */
        respawn(w);
        return;
      }

      let next;
      if (Math.random() < CHAOS) {
        next = options[Math.floor(Math.random() * options.length)];
      } else {
        /* Warnsdorff: take the tightest corner first, so the cells that would
           otherwise be orphaned get used while they are still reachable. */
        let best = Infinity;
        let tied = [];
        for (const o of options) {
          const n = freeNeighbours(o.x, o.y);
          if (n < best) {
            best = n;
            tied = [o];
          } else if (n === best) {
            tied.push(o);
          }
        }
        next = tied[Math.floor(Math.random() * tied.length)];
      }

      owner[idx(next.x, next.y)] = w.id;
      filled++;
      w.path.push(next);
    }

    /* Read once, not 24 times a second, to fetch a constant. */
    let groundColour = '#000';

    function drawPath(path, colour, width) {
      if (path.length === 0) return;
      const ox = SPACING * 0.5;
      const oy = SPACING * 0.5;
      ctx.strokeStyle = colour;
      ctx.lineWidth = width;
      ctx.beginPath();
      ctx.moveTo(ox + path[0].x * SPACING, oy + path[0].y * SPACING);
      for (let i = 1; i < path.length; i++) {
        ctx.lineTo(ox + path[i].x * SPACING, oy + path[i].y * SPACING);
      }
      ctx.stroke();
    }

    function draw() {
      ctx.fillStyle = groundColour;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      const ox = SPACING * 0.5;
      const oy = SPACING * 0.5;

      ctx.lineCap = 'square';
      ctx.lineJoin = 'miter';

      /* History first, so the live walkers draw on top of it. */
      for (const t of trails) drawPath(t.path, TRAIL[t.id - 1], 2);

      for (const w of walkers) {
        drawPath(w.path, LIVE[w.id - 1], 3);

        /* A live head gets a marker; a dead one does not, so you can see who
           is still going without any labels. */
        if (!w.dead && w.path.length) {
          const head = w.path[w.path.length - 1];
          ctx.fillStyle = LIVE[w.id - 1];
          ctx.fillRect(ox + head.x * SPACING - 3.5, oy + head.y * SPACING - 3.5, 7, 7);
        }
      }
    }

    function tick(now) {
      raf = requestAnimationFrame(tick);
      if (now - last < FRAME_MS) return;
      last = now;

      /* The grid genuinely fills now that trails persist, so this branch is
         reached on every cycle rather than being unreachable. A few cells are
         always sealed off in pockets nobody can enter, hence the 98%. */
      if (filled >= cols * rows * 0.98 || walkers.every((w) => w.dead)) {
        if (!holdUntil) holdUntil = now + 2200;
        if (now > holdUntil) {
          holdUntil = 0;
          reset();
        }
      } else {
        for (let s = 0; s < STEPS_PER_FRAME; s++) {
          for (const w of walkers) step(w);
        }
      }
      draw();
    }

    function size() {
      const w = innerWidth;
      const h = innerHeight;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.max(4, Math.floor(w / SPACING));
      rows = Math.max(4, Math.floor(h / SPACING));
      groundColour =
        getComputedStyle(document.documentElement)
          .getPropertyValue('--c-bg')
          .trim() || '#000';
      reset();
      draw();
    }

    function start() {
      if (running || reduced.matches) return;
      running = true;
      last = 0;
      raf = requestAnimationFrame(tick);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    size();

    if (reduced.matches) {
      /* One frozen frame: run the race to completion without painting it.
         Scaled to the grid rather than a flat 6000. On a phone the grid is
         about 400 cells, and 6000 iterations there meant tens of milliseconds
         of blocked main thread on load — imposed on exactly the visitors who
         asked for less work. Two passes over the grid fills it just as well. */
      const preroll = Math.max(400, cols * rows);
      for (let i = 0; i < preroll; i++) for (const w of walkers) step(w);
      draw();
    } else {
      start();
    }

    let resizeTimer = 0;
    addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(size, 200);
    });

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : start();
    });

    /* Off-screen is off. The hero is short, so this stops within a scroll. */
    const sentinel = document.getElementById('main') ?? document.body;
    new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { rootMargin: '0px 0px -60% 0px' },
    ).observe(sentinel);

    reduced.addEventListener('change', () => (reduced.matches ? stop() : start()));
  })();
</script>
