---
/**
 * Four self-avoiding walks filling a grid.
 *
 * Descended from younissk.github.io/p5-projects/Self avoiding walk, which is a
 * single walker doing a depth-first walk with backtracking. This runs four on
 * ONE shared grid, so they are self-avoiding and also avoid each other: a cell
 * anyone has visited is a wall forever.
 *
 * There is no goal. An earlier version raced them to one and it was over in a
 * second, because a walker that heads straight for a target does not explore.
 * Now they try to cover ground, and the interesting behaviour is the
 * competition for space: they carve each other's territory away, seal each
 * other into pockets, and eventually suffocate.
 *
 * Move choice is Warnsdorff's rule, the heuristic from the knight's tour: step
 * to the neighbour that has the FEWEST free neighbours of its own. That makes a
 * walker hug walls and its own trail, consume the awkward cells before they
 * become isolated, and survive far longer than a random step would. A small
 * chance of ignoring the rule keeps the shapes from being identical each round.
 *
 * A walker with nowhere to go dies, and dying frees every cell it ever took.
 * A replacement spawns immediately somewhere else, so there are always four
 * running and the animation never ends: territory is recycled rather than
 * consumed, and the grid settles into a churn instead of filling up and
 * stopping. There is still a hard reset if the grid somehow fills completely,
 * which the recycling makes close to impossible.
 *
 * Written against the raw 2D canvas rather than p5. p5.min.js is about a
 * megabyte, and this is the background of the most-visited page on a site whose
 * whole architecture is that nothing third-party loads at runtime.
 *
 * It is a background, so it yields: it stops when the tab is hidden, stops when
 * scrolled out of view, and renders a single finished frame instead of
 * animating when the visitor asks for reduced motion.
 */
---

<canvas id="walk-bg" aria-hidden="true"></canvas>

<style>
  /*
   * The frame is the canvas's own border rather than a separate element. That
   * keeps the simulation visibly inside it, and avoids stacking a fixed frame
   * between a z-index:-1 canvas and unpositioned text.
   */
  #walk-bg {
    position: fixed;
    top: var(--frame-inset);
    left: var(--frame-inset);
    /*
     * Sized explicitly, not with `inset`. A canvas is a REPLACED element, so
     * with all four offsets set and width:auto it takes its intrinsic 300x150
     * and parks in the corner instead of stretching. That is what happened the
     * first time this frame was added.
     */
    width: calc(100vw - 2 * var(--frame-inset));
    height: calc(100svh - 2 * var(--frame-inset));
    box-sizing: border-box;
    z-index: -1;
    display: block;
    border: var(--frame-width) solid var(--c-border-strong);
    pointer-events: none;
  }
</style>

<script is:inline>
  (() => {
    const canvas = document.getElementById('walk-bg');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const SPACING = 24;
    const STEPS_PER_FRAME = 1;
    const FRAME_MS = 1000 / 9;
    /* How often a walker ignores Warnsdorff and steps at random. Zero makes
       every round look the same; too much and they strangle themselves early. */
    const CHAOS = 0.12;

    /* Dim on purpose. This sits behind the hero and the text has to win. */
    const COLOURS = [
      'rgba(255, 228, 0, 0.55)',
      'rgba(255, 255, 255, 0.34)',
      'rgba(255, 255, 255, 0.18)',
      'rgba(255, 228, 0, 0.22)',
    ];

    let cols = 0;
    let rows = 0;
    let owner = new Int8Array(0); // 0 free, 1..4 = walker id
    let walkers = [];
    let filled = 0;
    let holdUntil = 0;
    let raf = 0;
    let last = 0;
    let running = false;

    const idx = (x, y) => y * cols + x;
    const inBounds = (x, y) => x >= 0 && x < cols && y >= 0 && y < rows;

    function reset() {
      owner = new Int8Array(cols * rows);
      filled = 0;

      walkers = [];
      for (let i = 0; i < 4; i++) {
        walkers.push({ id: i + 1, path: [], dead: false });
        respawn(walkers[i]);
      }
    }

    /** A free cell, or null when there is genuinely nowhere left. */
    function freeCell() {
      for (let tries = 0; tries < 300; tries++) {
        const x = Math.floor(Math.random() * cols);
        const y = Math.floor(Math.random() * rows);
        if (owner[idx(x, y)] === 0) return { x, y };
      }
      /* Random darts missed, so sweep. Cheap, and only runs when the grid is
         nearly full, which is exactly when darts stop working. */
      for (let i = 0; i < owner.length; i++) {
        if (owner[i] === 0) return { x: i % cols, y: Math.floor(i / cols) };
      }
      return null;
    }

    /** Free everything this walker took and drop it back in somewhere else. */
    function respawn(w) {
      for (const c of w.path) owner[idx(c.x, c.y)] = 0;
      filled -= w.path.length;

      const spot = freeCell();
      if (!spot) {
        w.path = [];
        w.dead = true;
        return;
      }
      owner[idx(spot.x, spot.y)] = w.id;
      filled++;
      w.path = [spot];
      w.dead = false;
    }

    function freeNeighbours(x, y) {
      let n = 0;
      if (inBounds(x + 1, y) && owner[idx(x + 1, y)] === 0) n++;
      if (inBounds(x - 1, y) && owner[idx(x - 1, y)] === 0) n++;
      if (inBounds(x, y + 1) && owner[idx(x, y + 1)] === 0) n++;
      if (inBounds(x, y - 1) && owner[idx(x, y - 1)] === 0) n++;
      return n;
    }

    function step(w) {
      if (w.dead) return;

      const head = w.path[w.path.length - 1];
      const options = [
        { x: head.x + 1, y: head.y },
        { x: head.x - 1, y: head.y },
        { x: head.x, y: head.y + 1 },
        { x: head.x, y: head.y - 1 },
      ].filter((n) => inBounds(n.x, n.y) && owner[idx(n.x, n.y)] === 0);

      if (options.length === 0) {
        /* Sealed in. It gives its territory back and starts over elsewhere,
           which is what keeps this running forever instead of silting up. */
        respawn(w);
        return;
      }

      let next;
      if (Math.random() < CHAOS) {
        next = options[Math.floor(Math.random() * options.length)];
      } else {
        /* Warnsdorff: take the tightest corner first, so the cells that would
           otherwise be orphaned get used while they are still reachable. */
        let best = Infinity;
        let tied = [];
        for (const o of options) {
          const n = freeNeighbours(o.x, o.y);
          if (n < best) {
            best = n;
            tied = [o];
          } else if (n === best) {
            tied.push(o);
          }
        }
        next = tied[Math.floor(Math.random() * tied.length)];
      }

      owner[idx(next.x, next.y)] = w.id;
      filled++;
      w.path.push(next);
    }

    function draw() {
      const styles = getComputedStyle(document.documentElement);
      ctx.fillStyle = styles.getPropertyValue('--c-bg').trim() || '#000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      const ox = SPACING * 0.5;
      const oy = SPACING * 0.5;

      ctx.lineCap = 'square';
      ctx.lineJoin = 'miter';

      for (const w of walkers) {
        if (w.path.length === 0) continue;
        ctx.strokeStyle = COLOURS[w.id - 1];
        ctx.lineWidth = 2;

        ctx.beginPath();
        ctx.moveTo(ox + w.path[0].x * SPACING, oy + w.path[0].y * SPACING);
        for (let i = 1; i < w.path.length; i++) {
          ctx.lineTo(ox + w.path[i].x * SPACING, oy + w.path[i].y * SPACING);
        }
        ctx.stroke();

        /* A live head gets a marker; a dead one does not, so you can see who
           is still going without any labels. */
        if (!w.dead) {
          const head = w.path[w.path.length - 1];
          ctx.fillStyle = ctx.strokeStyle;
          ctx.fillRect(ox + head.x * SPACING - 3, oy + head.y * SPACING - 3, 6, 6);
        }
      }
    }

    function tick(now) {
      raf = requestAnimationFrame(tick);
      if (now - last < FRAME_MS) return;
      last = now;

      if (filled >= cols * rows) {
        if (!holdUntil) holdUntil = now + 2200;
        if (now > holdUntil) {
          holdUntil = 0;
          reset();
        }
      } else {
        for (let s = 0; s < STEPS_PER_FRAME; s++) {
          for (const w of walkers) step(w);
        }
      }
      draw();
    }

    function size() {
      const w = innerWidth;
      const h = innerHeight;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.max(4, Math.floor(w / SPACING));
      rows = Math.max(4, Math.floor(h / SPACING));
      reset();
      draw();
    }

    function start() {
      if (running || reduced.matches) return;
      running = true;
      last = 0;
      raf = requestAnimationFrame(tick);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    size();

    if (reduced.matches) {
      /* One frozen frame: run the race to completion without painting it.
         Scaled to the grid rather than a flat 6000. On a phone the grid is
         about 400 cells, and 6000 iterations there meant tens of milliseconds
         of blocked main thread on load — imposed on exactly the visitors who
         asked for less work. Two passes over the grid fills it just as well. */
      const preroll = Math.max(400, cols * rows * 2);
      for (let i = 0; i < preroll; i++) for (const w of walkers) step(w);
      draw();
    } else {
      start();
    }

    let resizeTimer = 0;
    addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(size, 200);
    });

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : start();
    });

    /* Off-screen is off. The hero is short, so this stops within a scroll. */
    const sentinel = document.getElementById('main') ?? document.body;
    new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { rootMargin: '0px 0px -60% 0px' },
    ).observe(sentinel);

    reduced.addEventListener('change', () => (reduced.matches ? stop() : start()));
  })();
</script>
