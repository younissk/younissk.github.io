---
import { NAV, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg"
>
  <div class="page flex h-14 items-center justify-between gap-4">
    <a
      href="/"
      class="font-semibold tracking-tight text-ink transition-colors hover:text-accent"
      aria-label={`${SITE_TITLE} — home`}
    >
      {SITE_TITLE}
    </a>

    <div class="flex items-center gap-1">
      <nav class="hidden md:flex md:items-center md:gap-0.5" aria-label="Primary">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              title={item.blurb}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-sm px-2.5 py-1.5 text-sm transition-colors',
                isActive(item.href)
                  ? 'text-ink font-medium'
                  : 'text-ink-muted hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      {/* Discoverability: nobody guesses a shortcut that is never shown.
          Hidden on touch, where there is no ⌘K to press. */}
      <button type="button" class="cp-trigger ml-1" data-open-palette aria-label="Search this site">
        <span>Search</span>
        <kbd>⌘K</kbd>
      </button>

      <button
        type="button"
        data-theme-toggle
        class="ml-1 inline-flex size-9 items-center justify-center rounded-md text-ink-muted transition-colors hover:bg-surface hover:text-ink"
        aria-label="Switch colour theme"
        title="Switch colour theme"
      >
        <svg
          class="size-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg
          class="hidden size-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
      </button>

      <details class="menu md:hidden">
        <summary
          class="inline-flex size-9 cursor-pointer items-center justify-center rounded-md text-ink-muted transition-colors hover:bg-surface hover:text-ink"
          aria-label="Menu"
        >
          <svg
            class="icon-open size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
          <svg
            class="icon-close size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M5 5l14 14M19 5 5 19"></path>
          </svg>
        </summary>

        <nav
          class="absolute inset-x-0 top-full border-b border-border bg-bg"
          aria-label="Primary, mobile"
        >
          <ul class="page flex flex-col py-2">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'flex items-baseline justify-between gap-4 border-b border-border py-3 last:border-b-0',
                      isActive(item.href) ? 'text-ink' : 'text-ink-muted',
                    ]}
                  >
                    <span class="font-medium">{item.label}</span>
                    <span class="meta text-right">{item.blurb}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* CSS-only disclosure menu — no island, no hydration. */
  .menu > summary {
    list-style: none;
  }
  .menu > summary::-webkit-details-marker {
    display: none;
  }
  .menu > summary .icon-close {
    display: none;
  }
  .menu[open] > summary .icon-open {
    display: none;
  }
  .menu[open] > summary .icon-close {
    display: block;
  }
</style>

<script is:inline>
  // Theme toggle. Kept inline and delegated so it costs no bundle and needs no
  // hydration; the pre-paint bootstrap lives in BaseLayout's <head>.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('[data-theme-toggle]')) return;

    const root = document.documentElement;
    const dark = !root.classList.contains('dark');
    root.classList.toggle('dark', dark);
    root.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (_) {
      /* private mode — the toggle still works for this page view */
    }
  });

  // The palette hydrates on idle; this button just asks it to open. Delegated
  // for the same reason as above, and harmless before hydration.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('[data-open-palette]')) return;
    window.dispatchEvent(new CustomEvent('open-command-palette'));
  });
</script>
