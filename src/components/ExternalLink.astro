---
/**
 * Outbound link with the right rel/target and a small ↗ affordance.
 *
 *   <ExternalLink href="https://github.com/younissk/foo">Repository</ExternalLink>
 *   <ExternalLink href={url} icon={false} class="link-quiet">bare</ExternalLink>
 */
interface Props {
  href: string;
  /** Defaults to the `.link` treatment; pass e.g. "link-quiet" to override. */
  class?: string;
  /** Trailing arrow glyph. Turn off inside dense rows. */
  icon?: boolean;
  title?: string;
  /** Open in the same tab (rare — only for links you want to feel internal). */
  sameTab?: boolean;
}

const {
  href,
  class: className = 'link',
  icon = true,
  title,
  sameTab = false,
} = Astro.props;
---

<a
  href={href}
  class:list={[className, icon && 'inline-flex items-baseline gap-1']}
  title={title}
  target={sameTab ? undefined : '_blank'}
  rel="noopener noreferrer"
>
  <slot />
  {
    icon && (
      <svg
        class="inline-block size-[0.7em] shrink-0 translate-y-[-0.05em] opacity-70"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7M8 7h9v9" />
      </svg>
    )
  }
</a>
