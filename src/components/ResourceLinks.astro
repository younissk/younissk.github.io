---
/**
 * The links belonging to a piece of work, rendered as buttons at the top.
 *
 * These used to live in a sentence inside the prose ("Code: ... Dataset: ...").
 * Anyone arriving to fetch the model had to read a paragraph to find it. They
 * are frontmatter now, and they sit above the body on every post and project
 * that has them.
 *
 * Renders nothing when the list is empty, so a post with no artifacts does not
 * get an empty strip.
 */
import { LINK_KINDS } from '../content.config';

export interface ResourceLink {
  kind: string;
  label: string;
  url: string;
}

interface Props {
  links?: readonly ResourceLink[] | null;
  class?: string;
  /**
   * Cap on how many buttons render, with the first styled as primary.
   *
   * nanoBeard has nine links and rendering all nine here put three rows of
   * identical bordered buttons above the first sentence of prose. Where the
   * page already carries a grouped Links table further down, two is enough:
   * the obvious thing to open, and the write-up.
   */
  max?: number;
  /** Text for the overflow link, e.g. "All 9 links". */
  moreHref?: string;
}

/* Defaulted rather than required. An entry written before `links` existed in
   the schema has no array at all, and a missing list should render nothing,
   not throw on the page. */
const { links, class: className, max, moreHref } = Astro.props;
const list = Array.isArray(links) ? links : [];

/** Display order, so a repo never sits above the thing you can open. */
const order = new Map(LINK_KINDS.map((k, i) => [k as string, i]));
const sorted = [...list].sort(
  (a, b) => (order.get(a.kind) ?? 99) - (order.get(b.kind) ?? 99),
);

const shown = typeof max === 'number' ? sorted.slice(0, max) : sorted;
const hidden = sorted.length - shown.length;

const KIND_TITLE: Record<string, string> = {
  site: 'Live',
  demo: 'Demo',
  post: 'Write-up',
  video: 'Video',
  paper: 'Paper',
  model: 'Model',
  dataset: 'Dataset',
  repo: 'Repository',
};
---

{
  shown.length > 0 && (
    <nav class:list={['resource-links', className]} aria-label="Links and resources">
      {shown.map((l, i) => {
        const external = l.url.startsWith('http');
        return (
          <a
            class:list={['btn btn-sm', i === 0 && 'btn-primary']}
            href={l.url}
            title={`${KIND_TITLE[l.kind] ?? l.kind}: ${l.label}`}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            {l.label}
            {external ? ' ↗' : ''}
          </a>
        );
      })}
      {hidden > 0 && moreHref && (
        <a class="btn btn-sm btn-ghost" href={moreHref}>
          +{hidden} more ↓
        </a>
      )}
    </nav>
  )
}

<style>
  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
