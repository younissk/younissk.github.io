---
/**
 * Vim-style keyboard navigation, and the cheat sheet that documents it.
 *
 * `j`/`k` walk the items on a page, `gg`/`G` jump to its ends, `g` plus a letter
 * jumps between sections, `/` opens search and `?` shows the list. The bindings
 * and the sheet are generated from one map in src/lib/keymap.ts, so a shortcut
 * cannot drift from its own documentation.
 *
 * An inline script rather than an island: it is a keydown listener and a dialog,
 * which is not worth shipping a framework runtime for.
 *
 * ACCESSIBILITY. Single-character shortcuts are a WCAG 2.1 failure (SC 2.1.4,
 * level A) unless they can be turned off, because they steal keys from speech
 * input and from anyone whose assistive technology sends bare characters. So
 * there is a real off switch in the sheet, it persists, and the listener bails
 * out early whenever the caret is in a field, a modifier is held, or the command
 * palette already owns the keyboard.
 */
import { KEYMAP } from '../lib/keymap';
---

<div id="vim-sheet" class="vim-sheet" hidden>
  <div class="vim-backdrop" data-vim-close></div>

  <div class="vim-panel" role="dialog" aria-modal="true" aria-labelledby="vim-sheet-title">
    <div class="vim-head">
      <h2 id="vim-sheet-title" class="label">Keyboard</h2>
      <button type="button" class="vim-x" data-vim-close aria-label="Close">esc</button>
    </div>

    <div class="vim-groups">
      {
        KEYMAP.map((group) => (
          <section class="vim-group">
            <h3 class="label vim-group-title">{group.title}</h3>
            <dl class="vim-list">
              {group.bindings.map((binding) => (
                <div class="vim-row">
                  <dt class="vim-keys">
                    {binding.keys.map((key) => (
                      <kbd>{key}</kbd>
                    ))}
                  </dt>
                  <dd class="vim-label">{binding.label}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>

    <div class="vim-foot">
      <label class="vim-toggle">
        <input type="checkbox" id="vim-enabled" checked />
        <span>Single-key shortcuts</span>
      </label>
      <p class="meta vim-note">
        Turn them off if they get in the way. The choice is remembered on this
        device, and <kbd>⌘</kbd><kbd>K</kbd> keeps working either way.
      </p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ JUMPS_JSON: JSON.stringify(Object.fromEntries(KEYMAP.flatMap((g) => g.bindings).filter((b) => b.href && b.keys[0] === 'g' && b.keys.length === 2).map((b) => [b.keys[1], b.href]))) }}>
  (() => {
    const JUMPS = JSON.parse(JUMPS_JSON);
    const STORAGE_KEY = 'vim-keys';

    const sheet = document.getElementById('vim-sheet');
    const toggle = document.getElementById('vim-enabled');
    if (!sheet || !toggle) return;

    /* Off is a stored choice; anything else means on. localStorage throws in
       some privacy modes, so every access is guarded. */
    let enabled = true;
    try {
      enabled = localStorage.getItem(STORAGE_KEY) !== 'off';
    } catch {}
    toggle.checked = enabled;

    toggle.addEventListener('change', () => {
      enabled = toggle.checked;
      try {
        localStorage.setItem(STORAGE_KEY, enabled ? 'on' : 'off');
      } catch {}
    });

    /* Items j and k step through, in document order. Covers the list rows, the
       project cards, the video grid and the related-video blocks. */
    const ITEMS = [
      '.row-title a',
      '.pcard-title',
      '.video-link',
      '.related-video',
      '.landing-link',
    ].join(',');

    const items = () =>
      [...document.querySelectorAll(ITEMS)].filter(
        (el) => el.getBoundingClientRect().width > 0,
      );

    let index = -1;

    const focusAt = (next) => {
      const list = items();
      if (!list.length) return;
      index = Math.max(0, Math.min(next, list.length - 1));
      const el = list[index];
      el.focus({ preventScroll: true });
      el.scrollIntoView({
        block: 'center',
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth',
      });
    };

    /* Where the caret already is, the letters belong to the caret. */
    const typing = (target) => {
      if (!(target instanceof Element)) return false;
      if (target.closest('input, textarea, select, [contenteditable=""], [contenteditable="true"]')) return true;
      return false;
    };

    const sheetOpen = () => !sheet.hidden;
    const paletteOpen = () =>
      Boolean(document.querySelector('.cp-panel[role="dialog"]'));

    let lastKey = '';
    let lastAt = 0;

    /* Where focus was before the sheet took it. Closing without putting it back
       left the caret on the close button INSIDE hidden content, which is both a
       dead keyboard state and a thing screen readers should never be pointed
       at. */
    let restore = null;

    const openSheet = () => {
      restore = document.activeElement;
      sheet.hidden = false;
      document.body.style.overflow = 'hidden';
      sheet.querySelector('.vim-x')?.focus();
    };

    const closeSheet = () => {
      sheet.hidden = true;
      document.body.style.overflow = '';
      if (restore && document.contains(restore)) {
        restore.focus({ preventScroll: true });
      } else {
        /* Nothing sensible to go back to: park focus on the document rather
           than leave it inside the hidden panel. */
        document.activeElement?.blur?.();
      }
      restore = null;
    };

    /* Tab cycles inside the panel while it is open. aria-modal tells assistive
       tech to ignore the rest of the page; it does not stop Tab walking onto
       links behind the backdrop. */
    const trapTab = (event) => {
      if (event.key !== 'Tab' || sheet.hidden) return;
      const focusable = sheet.querySelectorAll('button, input, a[href]');
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };
    addEventListener('keydown', trapTab);

    for (const el of sheet.querySelectorAll('[data-vim-close]')) {
      el.addEventListener('click', closeSheet);
    }

    /* The footer hint, and anything else that wants to open the sheet. */
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('[data-vim-open]')) {
        event.preventDefault();
        openSheet();
      }
    });

    addEventListener('keydown', (event) => {
      /* ⌘K and friends belong to the browser and to the palette. */
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (typing(event.target)) return;

      if (event.key === 'Escape' && sheetOpen()) {
        event.preventDefault();
        closeSheet();
        return;
      }

      /* `?` opens the sheet even when the shortcuts are switched off, so the
         switch itself is always reachable. */
      if (event.key === '?') {
        event.preventDefault();
        sheetOpen() ? closeSheet() : openSheet();
        return;
      }

      if (!enabled || sheetOpen() || paletteOpen()) return;

      /* `/` is the search key on half the internet. */
      if (event.key === '/') {
        event.preventDefault();
        dispatchEvent(new CustomEvent('open-command-palette', { detail: { query: '' } }));
        return;
      }

      const now = Date.now();
      const chord = lastKey === 'g' && now - lastAt < 800;

      if (chord) {
        lastKey = '';
        if (event.key === 'g') {
          event.preventDefault();
          index = -1;
          scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }
        const href = JUMPS[event.key];
        if (href) {
          event.preventDefault();
          location.href = href;
          return;
        }
        return;
      }

      if (event.key === 'g') {
        lastKey = 'g';
        lastAt = now;
        return;
      }

      if (event.key === 'j') {
        event.preventDefault();
        focusAt(index + 1);
      } else if (event.key === 'k') {
        event.preventDefault();
        focusAt(index - 1);
      } else if (event.key === 'G') {
        event.preventDefault();
        index = items().length;
        scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
      }
    });
  })();
</script>

<style>
  .vim-sheet {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    padding: 1.25rem;
  }

  .vim-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0.86);
  }

  .vim-panel {
    position: relative;
    width: min(46rem, 100%);
    max-height: 85svh;
    overflow-y: auto;
    background-color: var(--c-bg);
    border: 3px solid var(--c-border-strong);
    padding: 1.4rem 1.5rem 1.5rem;
  }

  .vim-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 2px solid var(--c-border-strong);
  }

  .vim-x {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-ink-faint);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .vim-x:hover { color: var(--c-accent); }

  .vim-groups {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin-top: 1.4rem;
  }

  @media (min-width: 42rem) {
    .vim-groups { grid-template-columns: 1fr 1fr; }
    .vim-group:first-child { grid-row: span 2; }
  }

  .vim-group-title { color: var(--c-accent); }

  .vim-list {
    display: grid;
    gap: 0.15rem;
    margin: 0.7rem 0 0;
  }

  .vim-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0 0.9rem;
    padding: 0.3rem 0;
  }

  .vim-keys {
    display: flex;
    gap: 0.25rem;
  }

  .vim-keys kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    padding: 0.15rem 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 700;
    color: var(--c-ink);
    background-color: var(--c-surface-2);
    border: 1px solid var(--c-ink-faint);
    /* The one place a shadow earns itself: it makes the chip read as a key. */
    box-shadow: 0 2px 0 0 var(--c-ink-faint);
  }

  .vim-label {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-ink-muted);
  }

  .vim-foot {
    margin-top: 1.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-border);
  }

  .vim-toggle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .vim-toggle input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--c-accent);
  }

  .vim-note {
    margin-top: 0.5rem;
    max-width: 46ch;
  }

  .vim-note kbd {
    font-family: var(--font-mono);
    border: 1px solid var(--c-border);
    padding: 0 0.2rem;
  }
</style>
