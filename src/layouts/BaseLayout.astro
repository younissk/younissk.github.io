---
import '@fontsource-variable/inter';
import CommandPalette from '../components/CommandPalette';
import { buildSearchIndex } from '../lib/searchIndex';
import '../styles/global.css';

import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Root-relative or absolute URL to a social preview image. */
  ogImage?: string;
  noindex?: boolean;
  /** Passed through to Head — use 'article' on posts. */
  ogType?: 'website' | 'article';
  publishedTime?: string;
  /** Extra classes on <main>, e.g. for a full-bleed hero page. */
  mainClass?: string;
}

const { title, description, ogImage, noindex, ogType, publishedTime, mainClass } =
  Astro.props;

const searchEntries = await buildSearchIndex();
---

<!doctype html>
<html lang="en">
  <head>

    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      ogType={ogType}
      publishedTime={publishedTime}
    />
  </head>

  <body class="flex min-h-svh flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <Footer />
    <CommandPalette entries={searchEntries} client:idle />
  </body>
</html>
