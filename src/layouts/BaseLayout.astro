---
import '@fontsource-variable/inter';
import CommandPalette from '../components/CommandPalette';
import { buildSearchIndex } from '../lib/searchIndex';
import '../styles/global.css';

import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Root-relative or absolute URL to a social preview image. */
  ogImage?: string;
  noindex?: boolean;
  /** Passed through to Head — use 'article' on posts. */
  ogType?: 'website' | 'article';
  publishedTime?: string;
  /** Extra classes on <main>, e.g. for a full-bleed hero page. */
  mainClass?: string;
  /**
   * Drop the header and footer. The home page is a full-viewport landing with
   * nothing but the name, the profiles and a way in; chrome around it would be
   * the only thing on screen competing with the simulation behind it.
   *
   * The command palette still loads, so ⌘K works there too.
   */
  bare?: boolean;
}

const {
  title,
  description,
  ogImage,
  noindex,
  ogType,
  publishedTime,
  mainClass,
  bare = false,
} = Astro.props;

const searchEntries = await buildSearchIndex();
---

<!doctype html>
<html lang="en">
  <head>

    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      ogType={ogType}
      publishedTime={publishedTime}
    />
  </head>

  <body class="flex min-h-svh flex-col">
    {/* Nothing to skip past when there is no navigation above the content. */}
    {!bare && <a class="skip-link" href="#main">Skip to content</a>}
    {!bare && <Header />}
    <main id="main" class={mainClass}>
      <slot />
    </main>
    {!bare && <Footer />}
    <CommandPalette entries={searchEntries} client:idle />
  </body>
</html>
