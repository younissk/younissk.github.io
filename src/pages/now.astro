---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { AUTHOR } from '../consts';

const LAST_UPDATED = '2026-08';

// Specifics withheld pending an NDA check. Full list in git history.
const working: string[] = [];

const building = [
  {
    name: 'TempBench',
    href: 'https://younissk.github.io/TempBench-Temporal-LALM-Reasoning-benchmark/',
    what: 'whether audio-language models can answer trivial questions about event order and timing',
  },
  {
    name: 'Tython',
    href: 'https://younissk.github.io/tython/',
    what: 'a statically typed toy language, its standard library and its toolchain',
  },
  {
    name: 'nanoBeard',
    href: 'https://younissk.github.io/nanoBeard/',
    what: 'a small language model trained from scratch, then supervised fine-tuned',
  },
];
---

<BaseLayout
  title="Now"
  description="What Youniss is working on, studying and teaching right now. Updated 2026-08."
>
  <div class="page-narrow">
    <PageHeader
      eyebrow="Now"
      title="What I'm doing now"
      meta={[`Last updated: ${LAST_UPDATED}`]}
    />

    <section class="section">
      <div class="section-head">
        <h2 class="label">Working on</h2>
        <p class="meta">Since Mar 2026</p>
      </div>

      <p class="text-ink-muted">
        Applied AI, full time. Retrieval that has to stay current, and agents whose behaviour has
        to be checkable rather than taken on trust. Who I do it for, and on what, is withheld until
        I have checked what I am allowed to say.
      </p>

      {working.length > 0 && (
        <ul class="row-list mt-5">
          {working.map((item) => <li class="row text-ink-muted">{item}</li>)}
        </ul>
      )}
    </section>

    <section class="section">
      <div class="section-head">
        <h2 class="label">Studying</h2>
        <p class="meta">JKU Linz</p>
      </div>

      <p class="text-ink-muted">
        I finished my BSc in Artificial Intelligence at JKU Linz ahead of the standard duration,
        with a thesis on deep learning for language-based audio retrieval.
      </p>

      <p class="mt-4 text-ink-muted">
        The learning that is still happening happens in public, in three repositories I keep
        pushing to:
      </p>

      <ul class="row-list mt-5">
        {
          building.map((item) => (
            <li class="row">
              <ExternalLink class="link-quiet" href={item.href}>
                <span class="row-title">{item.name}</span>
              </ExternalLink>
              <p class="row-desc mt-0.5">{item.what}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <div class="section-head">
        <h2 class="label">Teaching</h2>
        <p class="meta">Dec 2024 – Feb 2026</p>
      </div>

      <p class="text-ink-muted">
        I taught AI programmes at several coding schools as a freelancer. LLMs, multi-modal models,
        frontend development. That run ended in February 2026 when I went full time, and I am not
        teaching a cohort at the moment. I liked it and would do it again.
      </p>
    </section>

    <section class="section">
      <div class="section-head">
        <h2 class="label">Reaching me</h2>
      </div>

      <p class="text-ink-muted">
        The <a class="link" href="/contact/">contact form</a> is the reliable channel.
      </p>

      <p class="meta mt-6">Last updated: {LAST_UPDATED}</p>
    </section>
  </div>
</BaseLayout>
