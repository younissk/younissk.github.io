---
/**
 * The video index. Reads the synced feed from src/data/videos.json — never the
 * YouTube API at request time, and deliberately no embeds: an iframe per card
 * would mean dozens of third-party requests on first paint.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { AUTHOR } from '../../consts';
import videosData from '../../data/videos.json';

interface Thumb {
  url: string;
  width: number;
  height: number;
}

interface Video {
  id: string;
  title: string;
  description: string;
  publishedAt: string;
  thumbnails: { default: Thumb | null; medium: Thumb | null; high: Thumb | null };
  duration: string | null;
  viewCount: number | null;
  url: string;
}

const videos = videosData as unknown as Video[];

/** "PT1H2M3S" → "1:02:03"; "PT12M34S" → "12:34"; "PT45S" → "0:45". */
function formatDuration(iso: string | null): string | null {
  if (!iso) return null;
  const m = /^P(?:(\d+)D)?T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/.exec(iso);
  if (!m) return null;
  const [days, hours, minutes, seconds] = m.slice(1).map((v) => Number(v ?? 0) || 0);
  const h = days * 24 + hours;
  const pad = (n: number) => String(n).padStart(2, '0');
  return h > 0
    ? `${h}:${pad(minutes)}:${pad(seconds)}`
    : `${minutes}:${pad(seconds)}`;
}

/** ISO date only — `.meta` renders tabular numerals, so digits stay aligned. */
function isoDate(value: string): string | null {
  const t = Date.parse(value);
  return Number.isFinite(t) ? new Date(t).toISOString().slice(0, 10) : null;
}

const cards = videos.map((v) => {
  const thumb = v.thumbnails.medium ?? v.thumbnails.high ?? v.thumbnails.default;
  return {
    id: v.id,
    title: v.title,
    date: isoDate(v.publishedAt),
    duration: formatDuration(v.duration),
    thumbUrl: thumb?.url ?? null,
    thumbWidth: thumb?.width ?? 320,
    thumbHeight: thumb?.height ?? 180,
  };
});

const latest = cards.find((c) => c.date)?.date;
const meta = [
  `${videos.length} ${videos.length === 1 ? 'video' : 'videos'}`,
  ...(latest ? [`latest ${latest}`] : []),
];
---

<BaseLayout
  title="Videos"
  description="Machine learning and engineering videos, indexed with their resources and notes."
>
  <div class="page">
    <PageHeader
      eyebrow="YouTube"
      title="Videos"
      meta={meta}
    >
      <Fragment slot="actions">
        <ExternalLink href={AUTHOR.youtube} class="btn" icon={false}>
          Channel
        </ExternalLink>
      </Fragment>
    </PageHeader>

    <section class="section">
      {
        cards.length === 0 ? (
          <div class="panel max-w-text">
            <p class="text-ink-muted">
              No videos are indexed yet. The feed is generated at build time from
              the YouTube Data API, so this page fills in as soon as the sync runs
              with credentials.
            </p>
            <p class="mt-3 text-ink-muted">
              In the meantime, the channel itself is at{' '}
              <ExternalLink href={AUTHOR.youtube}>youtube.com/@youniss-ml</ExternalLink>.
            </p>
          </div>
        ) : (
          <>
            <div class="section-head">
              <h2 class="label">All videos</h2>
              <p class="meta">newest first</p>
            </div>

            <ul class="mt-6 grid grid-cols-1 gap-x-gutter gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
              {cards.map((v) => (
                <li>
                  <a class="group block" href={`/videos/${v.id}/`}>
                    <div class="overflow-hidden rounded-panel border border-border bg-surface">
                      {v.thumbUrl ? (
                        <img
                          src={v.thumbUrl}
                          width={v.thumbWidth}
                          height={v.thumbHeight}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="block h-auto w-full"
                        />
                      ) : (
                        <div class="aspect-video w-full" />
                      )}
                    </div>

                    <h3 class="row-title mt-3 group-hover:text-accent">{v.title}</h3>

                    <ul class="meta-row mt-1.5">
                      {v.date && <li>{v.date}</li>}
                      {v.duration && <li class="tabular">{v.duration}</li>}
                    </ul>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>
  </div>
</BaseLayout>
