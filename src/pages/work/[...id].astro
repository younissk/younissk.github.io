---
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import Tag from '../../components/Tag.astro';
import ExternalLink from '../../components/ExternalLink.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: index > 0 ? entries[index - 1] : undefined,
      next: index < entries.length - 1 ? entries[index + 1] : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { title, org, role, period, summary, stack, metrics, links } = entry.data;
const { Content } = await render(entry);

const hasMetrics = (metrics?.length ?? 0) > 0;
const hasStack = stack.length > 0;
/** Never render an empty shell — the strip only exists if something real fills it. */
const hasStrip = hasMetrics || hasStack;

/** Hostname only: full URLs blow past 375px and add nothing a reader needs. */
function hostOf(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---

<BaseLayout title={title} description={summary} ogType="article">
  <div class="page">
    <PageHeader eyebrow="Case study" title={title} description={summary} meta={[org, role, period]}>
      <Fragment slot="actions">
        <a class="btn" href="/work/">All case studies</a>
      </Fragment>
    </PageHeader>

    {
      hasStrip && (
        <section class="border-t py-8" aria-label="At a glance">
          {hasMetrics && (
            <dl class="grid grid-cols-2 gap-x-gutter gap-y-6 sm:grid-cols-3 lg:grid-cols-4">
              {metrics!.map((metric) => (
                <div class="min-w-0">
                  <dt class="label">{metric.label}</dt>
                  <dd class="tabular mt-1.5 font-mono text-lg leading-tight text-ink">
                    {metric.value}
                  </dd>
                </div>
              ))}
            </dl>
          )}

          {hasStack && (
            <div class:list={[hasMetrics && 'mt-8']}>
              <h2 class="label">Stack</h2>
              <ul class="tag-row mt-2.5">
                {stack.map((item) => (
                  <li>
                    <Tag>{item}</Tag>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )
    }

    <div class="border-t py-section">
      <Prose class="max-w-text">
        <Content />
      </Prose>
    </div>

    {
      links && links.length > 0 && (
        <section class="border-t py-section" aria-labelledby="case-study-links">
          <div class="section-head">
            <h2 class="label" id="case-study-links">
              Links
            </h2>
            <p class="meta">{links.length}</p>
          </div>

          <ul class="row-list max-w-text">
            {links.map((link) => (
              <li>
                <div class="row">
                  <ExternalLink href={link.url} class="link-quiet">
                    <span class="row-title">{link.label}</span>
                  </ExternalLink>
                  <p class="meta mt-1">{hostOf(link.url)}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (prev || next) && (
        <nav
          class="flex flex-col gap-8 border-t py-10 sm:flex-row sm:items-start sm:justify-between sm:gap-gutter-lg"
          aria-label="Case studies"
        >
          {prev && (
            <a class="link-quiet block max-w-sm" href={`/work/${prev.id}/`} rel="prev">
              <span class="label block">← Previous</span>
              <span class="mt-1.5 block font-medium text-ink">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a
              class="link-quiet block max-w-sm sm:ml-auto sm:text-right"
              href={`/work/${next.id}/`}
              rel="next"
            >
              <span class="label block">Next →</span>
              <span class="mt-1.5 block font-medium text-ink">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>
