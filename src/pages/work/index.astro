---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Tag from '../../components/Tag.astro';

/** Curated, hand-ordered — `order` is the editorial ranking, not a date sort. */
const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Case studies from shipped roles: retrieval and agent infrastructure for emergency communication, document AI for Austrian construction software, an on-device language model, and a DCASE challenge submission."
>
  <div class="page">
    <PageHeader
      eyebrow="Case studies"
      title="Work"
      description="The work I would want to be judged on, written up in depth — what the problem was, what I built, how it actually works, and what came out of it."
      meta={[`${entries.length} case studies`, 'ONDEWO · ib-data (ABK) · JKU Linz']}
    />

    <section class="section" aria-labelledby="all-case-studies">
      <div class="section-head">
        <h2 class="label" id="all-case-studies">All case studies</h2>
        <p class="meta">{entries.length} entries</p>
      </div>

      <ul class="row-list">
        {
          entries.map((entry) => (
            <li>
              <a class="row" href={`/work/${entry.id}/`}>
                <span class="row-title">{entry.data.title}</span>
                <p class="row-desc mt-1">{entry.data.summary}</p>

                <ul class="meta-row mt-2">
                  <li>{entry.data.org}</li>
                  <li>{entry.data.role}</li>
                  <li>{entry.data.period}</li>
                </ul>

                <ul class="tag-row mt-2.5">
                  {entry.data.stack.map((item) => (
                    <li>
                      <Tag>{item}</Tag>
                    </li>
                  ))}
                </ul>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
