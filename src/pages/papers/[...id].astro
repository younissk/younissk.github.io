---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmbeddingSpace from '../../components/EmbeddingSpace';
import Prose from '../../components/Prose.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Bibtex from '../../components/Bibtex';
import { SITE_URL, PERSON_ID } from '../../consts';

export async function getStaticPaths() {
  const papers = await getCollection('papers');
  return papers.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'papers'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

/**
 * The thesis gets an interactive figure: the renderings it is about, laid out
 * by what they contain. Nothing else on the site loads three.js, so it is
 * gated on this one entry and on `client:visible`.
 */
const SHOWS_EMBEDDING_SPACE = entry.id === 'vision-mediated-audio-text-retrieval';
const { title, authors, venue, year, type, pdf, url, doi, bibtex } = entry.data;

const isSelf = (author: string) => /kandah/i.test(author);
const readable = (value: string) => value.replace(/-/g, ' ');

/* The meta description used to be provenance ("seminar paper, JKU Linz — Seminar
   Paper (2025). By ..."), which repeated the venue twice, started lowercase and
   said nothing about the work. The abstract's first sentence says what it is. */
const abstract = (entry.body ?? '')
  .replace(/\s+/g, ' ')
  .trim();
const firstSentence = abstract.split(/(?<=[.!?])\s/)[0] ?? '';
const paperDescription =
  firstSentence.length > 60 ? firstSentence.slice(0, 300) : `${readable(type)}, ${year}. ${abstract.slice(0, 220)}`.trim();

/* ScholarlyArticle is the strongest single signal for "what has this person
   published". The author list stays accurate here — this is a citation — and
   the self-authored entry points at the site-wide Person node so a consumer can
   join the paper to the site. */
const paperSchema = {
  '@context': 'https://schema.org',
  '@type': type === 'thesis' ? 'Thesis' : 'ScholarlyArticle',
  headline: title,
  name: title,
  abstract: abstract.slice(0, 1200) || undefined,
  datePublished: String(year),
  inLanguage: 'en',
  url: new URL(`/papers/${entry.id}/`, SITE_URL).href,
  author: authors.map((a) =>
    isSelf(a) ? { '@id': PERSON_ID } : { '@type': 'Person', name: a },
  ),
  publisher: { '@type': 'Organization', name: venue },
  ...(pdf ? { encoding: { '@type': 'MediaObject', contentUrl: new URL(pdf, SITE_URL).href, encodingFormat: 'application/pdf' } } : {}),
  ...(doi ? { identifier: `https://doi.org/${doi}` } : {}),
  ...(url ? { sameAs: url } : {}),
};
---

<BaseLayout
  title={title}
  description={paperDescription}
  ogType="article"
  schema={paperSchema}
>
  <div class="page-narrow">
    <PageHeader eyebrow={readable(type)} title={title} meta={[String(year), venue]}>
      <Fragment slot="actions">
        <a class="btn btn-primary" href={pdf}>Read the PDF</a>
      </Fragment>

      <p class="text-ink-muted">
        {
          authors.map((author, index) => (
            <Fragment>
              {index > 0 && <span>, </span>}
              {isSelf(author) ? (
                <strong class="font-semibold text-ink">{author}</strong>
              ) : (
                <span>{author}</span>
              )}
            </Fragment>
          ))
        }
      </p>
    </PageHeader>

    <section class="section">
      <div class="section-head">
        <h2 class="label">Abstract</h2>
      </div>
      <Prose><Content /></Prose>

      {SHOWS_EMBEDDING_SPACE && <EmbeddingSpace client:visible />}
    </section>

    <section class="section">
      <div class="section-head">
        <h2 class="label">Cite</h2>
      </div>
      <Bibtex client:visible bibtex={bibtex} describes={title} defaultOpen />
    </section>

    <section class="section">
      <div class="section-head">
        <h2 class="label">Links</h2>
      </div>
      <ul class="row-list">
        <li class="row">
          <a class="link-quiet" href={pdf}>PDF</a>
        </li>
        {
          url && (
            <li class="row">
              <ExternalLink class="link-quiet" href={url}>
                Official page
              </ExternalLink>
            </li>
          )
        }
        {
          doi && (
            <li class="row">
              <ExternalLink class="link-quiet" href={`https://doi.org/${doi}`}>
                {`doi:${doi}`}
              </ExternalLink>
            </li>
          )
        }
        <li class="row">
          <a class="link-quiet" href="/papers/">All papers</a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
