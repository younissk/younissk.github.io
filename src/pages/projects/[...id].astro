---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Prose from '../../components/Prose.astro';
import Tag from '../../components/Tag.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { SITE_URL, PERSON_ID } from '../../consts';
import {
  formatCount,
  linkCount,
  type Metrics,
} from '../../components/ProjectIndex';
import metricsData from '../../data/metrics.json';

/**
 * Same build-time snapshot the archive index uses, and the same lookup helper,
 * imported rather than reimplemented so the rule about what counts as a number
 * worth showing (and the rule that zero is not one) lives in exactly one place.
 * These are plain functions used in the frontmatter, so nothing here ships any
 * JavaScript to this page.
 */
const metrics = metricsData as unknown as Metrics;

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);

/** Only links that actually exist — a missing repo is a marker, never a dead link. */
const KIND_LABEL: Record<string, string> = {
  site: 'Live',
  demo: 'Demo',
  post: 'Writing',
  video: 'Video',
  paper: 'Paper',
  model: 'Models',
  dataset: 'Datasets',
  repo: 'Code',
};

/** Every link this project has, in schema order. Nothing is invented. */
const links = p.links.map((l) => ({
  ...l,
  external: l.url.startsWith('http'),
  primary: l.kind === 'site' || l.kind === 'demo',
  /** null for anything unmeasured, unpublished, or sitting at zero. */
  count: linkCount(l.url, metrics),
}));

/**
 * The header carries the few actions someone actually wants at the top; the
 * grouped Links table further down carries every one of them. nanoBeard has
 * nine links and rendering all nine as buttons under the title was a wall.
 */
const headline = links.filter((l) => l.primary || l.kind === 'repo').slice(0, 4);

/** Grouped for the details table, so six model links read as one row. */
const grouped = Object.entries(
  links.reduce<Record<string, typeof links>>((acc, l) => {
    (acc[l.kind] ??= []).push(l);
    return acc;
  }, {}),
);

const meta = [p.period, p.category, p.status, p.private ? 'private repository' : null].filter(
  Boolean,
) as string[];

/** Neighbours in the same category, so a thin entry still leads somewhere. */
const siblings = (await getCollection('projects'))
  .filter((other) => other.id !== entry.id && other.data.category === p.category)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);

/* SoftwareSourceCode answers "what has this person built". Only public repos
   get a codeRepository — a private one has no URL anyone can follow. */
const repoLink = p.private ? null : links.find((l) => l.kind === 'repo')?.url;

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: p.title,
  description: p.summary,
  url: new URL(`/projects/${entry.id}/`, SITE_URL).href,
  dateCreated: String(p.year),
  author: { '@id': PERSON_ID },
  keywords: [...p.tags, ...p.stack].join(', '),
  ...(p.stack.length ? { programmingLanguage: p.stack } : {}),
  ...(repoLink ? { codeRepository: repoLink } : {}),
};
---

<BaseLayout title={p.title} description={p.summary} ogType="article" schema={projectSchema}>
  <div class="page">
    <p class="pt-8 md:pt-10">
      <a class="meta link-quiet" href="/projects/">← All projects</a>
    </p>

    <PageHeader
      class="pt-4 md:pt-5"
      eyebrow={p.category}
      title={p.title}
      description={p.summary}
      meta={meta}
    >
      <Fragment slot="actions">
        {/* Two buttons, not nine. The grouped Links table in the rail carries
            every one of them. */}
        <ResourceLinks links={p.links} max={2} moreHref="#details" />
      </Fragment>
    </PageHeader>

    <div class="detail-grid">
      <section class="section pt-0 detail-body">
        <h2 class="sr-only">About {p.title}</h2>
        <Prose>
          <Content />
        </Prose>
      </section>

      <aside class="detail-rail" id="details">
      <div class="section-head">
        <h2 class="label">Details</h2>
        <p class="meta">{p.repoName}</p>
      </div>

      <dl class="grid gap-x-6 gap-y-5">
        <dt class="label">Stack</dt>
        <dd>
          <ul class="tag-row">
            {p.stack.map((item) => <li><Tag>{item}</Tag></li>)}
          </ul>
        </dd>

        <dt class="label">Tags</dt>
        <dd>
          <ul class="tag-row">
            {
              p.tags.map((tag) => (
                <li>
                  <Tag href={`/projects/?tags=${encodeURIComponent(tag)}`}>{tag}</Tag>
                </li>
              ))
            }
          </ul>
        </dd>

        <dt class="label">Links</dt>
        <dd>
          {
            grouped.length > 0 ? (
              <dl class="grid gap-y-2">
                {grouped.map(([kind, items]) => (
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <dt class="meta w-20 shrink-0">{KIND_LABEL[kind] ?? kind}</dt>
                    <dd class="flex flex-wrap gap-x-3 gap-y-1">
                      {items.map((link) => (
                        <span class="inline-flex items-baseline gap-1.5">
                          {link.external ? (
                            <ExternalLink href={link.url} class="link-quiet" icon={false}>
                              {link.label}
                            </ExternalLink>
                          ) : (
                            <a class="link-quiet" href={link.url}>
                              {link.label}
                            </a>
                          )}
                          {/* The table has room the card buttons do not, so the
                              unit is spelled out here rather than implied. */}
                          {link.count && (
                            <span class="tabular font-mono text-meta text-ink-faint">
                              {formatCount(link.count.value)} {link.count.unit}
                            </span>
                          )}
                        </span>
                      ))}
                    </dd>
                  </div>
                ))}
              </dl>
            ) : (
              <span class="meta">{p.private ? 'Private repository' : 'None'}</span>
            )
          }
        </dd>
      </dl>
      </aside>
    </div>

    {
      siblings.length > 0 && (
        <section class="section">
          <div class="section-head">
            <h2 class="label">More in {p.category}</h2>
            <a class="meta link-quiet" href={`/projects/?category=${p.category}`}>
              See all
            </a>
          </div>
          <ul class="row-list">
            {siblings.map((other) => (
              <li class="row">
                <a class="row-title link-quiet block" href={`/projects/${other.id}/`}>
                  {other.data.title}
                </a>
                <ul class="meta-row mt-1">
                  <li class="tabular">{other.data.year}</li>
                  <li>{other.data.status}</li>
                </ul>
                <p class="row-desc mt-1.5">{other.data.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
