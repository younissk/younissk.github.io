---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectIndex, {
  syncedAt,
  type Metrics,
  type ProjectRow,
} from '../../components/ProjectIndex';
import { markFor } from '../../lib/mark';
import metricsData from '../../data/metrics.json';
import { PROJECT_CATEGORIES } from '../../content.config';
import { AUTHOR } from '../../consts';

/**
 * Public platform counters, read at build time and baked into the HTML.
 *
 * TypeScript infers a literal shape from whatever keys the JSON happens to
 * hold today — and `{}` when the file is empty, which is the supported
 * fallback. The cast is what keeps the component's contract stable across
 * both, and it is the only place in the render path that knows this file is
 * JSON rather than a typed module.
 */
const metrics = metricsData as unknown as Metrics;
const synced = syncedAt(metrics);

const entries = await getCollection('projects');

/**
 * Lean, plain-serialisable payload for the island — only the fields it reads.
 * Sorted newest-first here so the server-rendered HTML (which the island
 * hydrates over, and which is what a crawler or a JS-less reader sees) already
 * matches the island's default sort.
 */
const projects: ProjectRow[] = entries
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    repoName: entry.data.repoName,
    summary: entry.data.summary,
    year: entry.data.year,
    period: entry.data.period,
    category: entry.data.category,
    status: entry.data.status,
    tags: entry.data.tags,
    stack: entry.data.stack,
    links: entry.data.links,
    /* Whether the detail page has prose worth opening, rather than just a stub. */
    hasBody: (entry.body ?? '').trim().length > 0,
    private: entry.data.private,
    featured: entry.data.featured,
    /* Deterministic from the slug, computed here so the island ships no
       generator code. */
    mark: (() => {
      const { path, cols, rows } = markFor(entry.id, 14, 5);
      return { path, cols, rows };
    })(),
  }))
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));

const years = projects.map((p) => p.year);
const span = `${Math.min(...years)}–${Math.max(...years)}`;
const publicCount = projects.filter((p) => !p.private).length;

/**
 * Dating the counters is the honest part. They are a committed snapshot, not a
 * live feed, and saying so is what stops a number that has not moved in three
 * months from reading as a number nobody wants. Omitted entirely when there is
 * no snapshot — an undated claim would be worse than no claim.
 */
const meta = [
  `${projects.length} projects`,
  span,
  `${publicCount} public repositories`,
  ...(synced ? [`downloads and stars as of ${synced}`] : []),
];
---

<BaseLayout
  title="Projects"
  description={`Everything I have built. ${projects.length} projects, filterable by category, stack and tag.`}
>
  <div class="page">
    <PageHeader
      eyebrow="Archive"
      title="Projects"
      meta={meta}
    >
      <Fragment slot="actions">
        <a class="btn" href={AUTHOR.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </Fragment>
    </PageHeader>

    <section class="section">
      <h2 class="sr-only">Project archive</h2>
      <ProjectIndex
        client:load
        projects={projects}
        categories={PROJECT_CATEGORIES}
        metrics={metrics}
      />
    </section>
  </div>
</BaseLayout>
