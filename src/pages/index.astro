---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import WalkBackground from '../components/WalkBackground.astro';
import { AUTHOR, NAV, SITE_DESCRIPTION } from '../consts';

/**
 * The landing page: one screen, no chrome.
 *
 * No header, no footer, no sections. Name, profiles, a way into each of the
 * other pages, and search. Everything else on this site is one click from here,
 * and the simulation behind it gets the whole viewport instead of a strip.
 */
---

<BaseLayout
  title={`${AUTHOR.name} — ${AUTHOR.role}`}
  description={SITE_DESCRIPTION}
  bare
  mainClass="landing"
>
  <WalkBackground />

  <div class="landing-inner">
    <p class="label">{AUTHOR.role}</p>

    <div class="landing-head">
      <h1 class="text-ink text-display font-semibold">{AUTHOR.name}</h1>

      {/* A real input, not a button dressed as one. Typing here opens the
          palette and carries the keystrokes across, so the first characters
          are never swallowed. */}
      <div class="landing-search">
        <input
          id="landing-search"
          type="text"
          class="landing-search-input"
          placeholder="Search"
          aria-label="Search this site"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="landing-search-kbd">⌘K</kbd>
      </div>
    </div>

    <nav class="landing-nav mt-9" aria-label="Sections">
      {
        NAV.map((item) => (
          <a class="landing-link" href={item.href}>
            <span class="landing-link-label">{item.label}</span>
            <span class="landing-link-blurb">{item.blurb}</span>
          </a>
        ))
      }
    </nav>
  </div>

  <div class="landing-foot">
    <SocialLinks />
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const box = document.getElementById('landing-search');
    if (!box) return;

    const openWith = (query) => {
      window.dispatchEvent(
        new CustomEvent('open-command-palette', { detail: { query } }),
      );
      /* The palette owns the input from here; clear this one so returning to
         the page does not show a stale query. */
      box.value = '';
      box.blur();
    };

    box.addEventListener('focus', () => openWith(''));
    box.addEventListener('input', () => openWith(box.value));
  })();
</script>

<style is:global>
  .landing {
    flex: 1;
    min-height: 100svh;
    display: grid;
    /* Content centred in the free space, profiles parked on the last row. */
    grid-template-rows: 1fr auto;
    justify-items: center;
    padding: 2rem 1.25rem;
  }
</style>

<style>
  .landing-inner {
    width: 100%;
    max-width: 44rem;
    align-self: center;
  }

  .landing-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .landing-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 1 14rem;
    min-width: 12rem;
    max-width: 20rem;
    padding: 0.5rem 0.7rem;
    border: 2px solid var(--c-border-strong);
    background-color: var(--c-surface);
  }

  .landing-search:focus-within {
    border-color: var(--c-accent);
  }

  .landing-search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--c-ink);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .landing-search-input:focus {
    outline: none;
  }

  .landing-search-input::placeholder {
    color: var(--c-ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .landing-search-kbd {
    flex-shrink: 0;
    border: 1px solid var(--c-border-strong);
    padding: 0 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--c-ink-faint);
  }

  .landing-foot {
    width: 100%;
    max-width: 44rem;
    padding-top: 2rem;
  }

  .landing-nav {
    display: grid;
    gap: 0;
    border-top: 2px solid var(--c-border-strong);
  }

  .landing-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    width: 100%;
    padding: 0.85rem 0.25rem;
    border-bottom: 2px solid var(--c-border);
    text-align: left;
    color: var(--c-ink);
    background: transparent;
    cursor: pointer;
  }

  .landing-link:hover,
  .landing-link:focus-visible {
    background-color: var(--c-accent);
    color: #000;
    border-bottom-color: var(--c-accent);
  }

  .landing-link-label {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .landing-link-blurb {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--c-ink-faint);
  }

  .landing-link:hover .landing-link-blurb,
  .landing-link:focus-visible .landing-link-blurb {
    color: #000;
  }

  .landing-link kbd {
    border: 1px solid currentColor;
    padding: 0 0.25rem;
    font: inherit;
  }
</style>
