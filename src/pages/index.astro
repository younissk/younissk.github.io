---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import WalkBackground from '../components/WalkBackground.astro';
import { AUTHOR, NAV, SITE_DESCRIPTION } from '../consts';

/**
 * The landing page: one screen, no chrome.
 *
 * No header, no footer, no sections. Name, profiles, a way into each of the
 * other pages, and search. Everything else on this site is one click from here,
 * and the simulation behind it gets the whole viewport instead of a strip.
 */
---

<BaseLayout
  title={`${AUTHOR.name} — ${AUTHOR.role}`}
  description={SITE_DESCRIPTION}
  bare
  mainClass="landing"
>
  <WalkBackground />

  {/*
    A rule inset from the edge of the viewport, so the whole screen reads as a
    framed plate. A div, not a border on the canvas: a canvas is a replaced
    element, so `inset` with an auto width leaves it at its intrinsic 300x150
    in the corner instead of stretching. A div stretches.

    Sits at z-index -1 like the canvas and comes after it in the DOM, so it
    paints over the simulation and under every piece of text.
  */}
  <div class="screen-frame" aria-hidden="true"></div>

  <div class="landing-inner">
    <p class="label">{AUTHOR.role}</p>

    <h1 class="landing-name">{AUTHOR.name}</h1>

    {/* Still a real input, not a button dressed as one — typing here carries
        the keystrokes into the palette. Moved below the name and stripped of
        its box: at hero size the name has to be the only loud thing, and a
        2px-bordered field sitting beside it was winning. */}
    <div class="landing-search">
      <svg class="landing-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="landing-search"
        type="text"
        class="landing-search-input"
        placeholder="Search everything"
        aria-label="Search this site"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="landing-search-kbd">⌘K</kbd>
    </div>

    <nav class="landing-nav" aria-label="Sections">
      {
        NAV.map((item) => (
          <a class="landing-link" href={item.href}>
            <span class="landing-link-label">{item.label}</span>
            <span class="landing-link-blurb">{item.blurb}</span>
          </a>
        ))
      }
    </nav>
  </div>

  <div class="landing-foot">
    <SocialLinks />
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const box = document.getElementById('landing-search');
    if (!box) return;

    const openWith = (query) => {
      window.dispatchEvent(
        new CustomEvent('open-command-palette', { detail: { query } }),
      );
      /* The palette owns the input from here, and it focuses its own field on
         open, so focus moves by itself. Clear this one so returning to the page
         does not show a stale query. Deliberately no blur(): before the island
         hydrates nothing is listening, and blurring would leave a box that
         cannot be typed into. */
      box.value = '';
    };

    /* Open on intent, never on focus.
     *
     * A focus listener here meant Tab alone opened the palette. Tabbing
     * backwards from a nav link fired it while focus was thrown elsewhere, so
     * the dialog was open with focus outside it and its Escape handler could
     * never run: a modal that keyboard users could not dismiss. Typing, a
     * deliberate click, and Enter or Down are all real intent. Tab is not, and
     * now passes straight through to the links below. */
    box.addEventListener('input', () => openWith(box.value));

    box.addEventListener('mousedown', (event) => {
      /* Stop the box taking focus, so the palette's own field keeps it. */
      event.preventDefault();
      openWith('');
    });

    box.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === 'ArrowDown') {
        event.preventDefault();
        openWith('');
      }
    });
  })();
</script>

<style is:global>
  /* One inset for the frame, shared by the canvas border and the content
     padding, so the text never sits under the rule. */
  :root {
    --frame-inset: clamp(0.75rem, 2vw, 1.75rem);
    --frame-width: 2px;
  }

  .screen-frame {
    position: fixed;
    inset: var(--frame-inset);
    z-index: -1;
    border: var(--frame-width) solid var(--c-border-strong);
    pointer-events: none;
  }

  /* Three rows: a little air, the plate, then the profiles pinned to the
     bottom. The old grid centred a short block in one big free row, which left
     a dead band under the nav and made the whole composition float. */
  .landing {
    flex: 1;
    min-height: 100svh;
    display: grid;
    grid-template-rows: minmax(2rem, 1fr) auto minmax(2rem, 0.55fr);
    justify-items: center;
    padding: calc(var(--frame-inset) + 1.5rem) calc(var(--frame-inset) + 1.5rem);
  }
</style>

<style>
  .landing-inner {
    grid-row: 2;
    position: relative;
    width: 100%;
    max-width: 54rem;
  }

  /* A scrim, not a panel.
     Now that the simulation actually draws, its lines run straight through the
     nav and the search line and the text stopped winning. This restores the
     ground under the words without putting a visible box around them: opaque
     at the centre, gone by the edges, so the walkers still read as continuous
     behind it. Sits above the canvas (z-index -1) and below the text. */
  .landing-inner::before,
  .landing-foot::before {
    content: "";
    position: absolute;
    inset: -1.75rem -2.25rem;
    z-index: -1;
    background: radial-gradient(
      ellipse 70% 60% at 50% 50%,
      rgb(0 0 0 / 0.82) 0%,
      rgb(0 0 0 / 0.62) 55%,
      rgb(0 0 0 / 0) 100%
    );
    pointer-events: none;
  }

  /* The whole point of this page. Roughly 16-25% of viewport height, set in
     the display face, tracked tight enough to read as one mass. */
  .landing-name {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.86;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--c-ink);
    margin: 0.35rem 0 0;
  }

  /* Quiet by construction: no box, one hairline under it. It reads as a line
     of the page rather than a control competing with the name. */
  .landing-search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    margin-top: 1.6rem;
    padding: 0.55rem 0.15rem;
    border-bottom: 2px solid var(--c-ink-faint);
    transition: border-color 140ms ease;
  }

  .landing-search:focus-within {
    border-bottom-color: var(--c-accent);
  }

  .landing-search-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--c-ink-faint);
  }

  .landing-search:focus-within .landing-search-icon {
    color: var(--c-accent);
  }

  .landing-search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--c-ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .landing-search-input:focus {
    outline: none;
  }

  .landing-search-input::placeholder {
    color: var(--c-ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .landing-search-kbd {
    flex-shrink: 0;
    padding: 0 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--c-ink-faint);
  }

  .landing-foot {
    grid-row: 3;
    position: relative;
    align-self: end;
    width: 100%;
    max-width: 54rem;
  }

  .landing-nav {
    display: grid;
    gap: 0;
    margin-top: 2.75rem;
    border-top: 2px solid var(--c-border-strong);
  }

  .landing-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    width: 100%;
    padding: 0.95rem 0.25rem;
    border-bottom: 2px solid var(--c-ink-faint);
    text-align: left;
    color: var(--c-ink);
    background: transparent;
    cursor: pointer;
    /* The one place on the site where a hover moves something. */
    transition: padding-left 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 140ms ease, border-color 140ms ease;
  }

  .landing-link:hover,
  .landing-link:focus-visible {
    background-color: var(--c-accent);
    color: #000;
    border-bottom-color: var(--c-accent);
    padding-left: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-link { transition: none; }
    .landing-link:hover,
    .landing-link:focus-visible { padding-left: 0.25rem; }
  }

  .landing-link-label {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .landing-link-blurb {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--c-ink-faint);
  }

  .landing-link:hover .landing-link-blurb,
  .landing-link:focus-visible .landing-link-blurb {
    color: #000;
  }
</style>
