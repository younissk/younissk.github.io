---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import WalkBackground from '../components/WalkBackground.astro';
import { AUTHOR, NAV, SITE_DESCRIPTION } from '../consts';

/**
 * The landing page: one screen, no chrome.
 *
 * No header, no footer, no sections. Name, profiles, a way into each of the
 * other pages, and search. Everything else on this site is one click from here,
 * and the simulation behind it gets the whole viewport instead of a strip.
 */
---

<BaseLayout
  title={`${AUTHOR.name} — ${AUTHOR.role}`}
  description={SITE_DESCRIPTION}
  bare
  mainClass="landing"
>
  <WalkBackground />

  <div class="landing-inner">
    <p class="label">{AUTHOR.role}</p>
    <h1 class="text-ink text-display font-semibold mt-2">{AUTHOR.name}</h1>

    <SocialLinks class="mt-7" />

    <nav class="landing-nav mt-10" aria-label="Sections">
      {
        NAV.map((item) => (
          <a class="landing-link" href={item.href}>
            <span class="landing-link-label">{item.label}</span>
            <span class="landing-link-blurb">{item.blurb}</span>
          </a>
        ))
      }
      <button type="button" class="landing-link" data-open-palette aria-label="Search this site">
        <span class="landing-link-label">Search</span>
        <span class="landing-link-blurb">Everything, one keystroke &nbsp;<kbd>⌘K</kbd></span>
      </button>
    </nav>
  </div>
</BaseLayout>

<script is:inline>
  // The palette hydrates on idle; this only asks it to open. Delegated, so it
  // is harmless before hydration and needs no island of its own.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('[data-open-palette]')) return;
    window.dispatchEvent(new CustomEvent('open-command-palette'));
  });
</script>

<style is:global>
  .landing {
    flex: 1;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 2rem 1.25rem;
  }
</style>

<style>
  .landing-inner {
    width: 100%;
    max-width: 44rem;
  }

  .landing-nav {
    display: grid;
    gap: 0;
    border-top: 2px solid var(--c-border-strong);
  }

  .landing-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    width: 100%;
    padding: 0.85rem 0.25rem;
    border-bottom: 2px solid var(--c-border);
    text-align: left;
    color: var(--c-ink);
    background: transparent;
    cursor: pointer;
  }

  .landing-link:hover,
  .landing-link:focus-visible {
    background-color: var(--c-accent);
    color: #000;
    border-bottom-color: var(--c-accent);
  }

  .landing-link-label {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .landing-link-blurb {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--c-ink-faint);
  }

  .landing-link:hover .landing-link-blurb,
  .landing-link:focus-visible .landing-link-blurb {
    color: #000;
  }

  .landing-link kbd {
    border: 1px solid currentColor;
    padding: 0 0.25rem;
    font: inherit;
  }
</style>
