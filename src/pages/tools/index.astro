---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Tag from '../../components/Tag.astro';

/**
 * /tools is a VIEW over projects, not its own collection.
 *
 * Every tool was already a project, so two files per thing meant two
 * descriptions that drifted apart — the privacy-journal tool card was still
 * pitching the abandoned on-device app while the project entry described the
 * GitHub-backed web one. A project earns a place here by declaring a `tool`
 * block: a present-tense pitch and a URL you can actually open.
 */
const tools = (await getCollection('projects'))
  .filter((p) => p.data.tool)
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));

const STATUS_NOTE: Record<string, string> = {
  live: 'live',
  wip: 'in progress',
  retired: 'retired',
};
---

<BaseLayout
  title="Tools"
  description="Free things Youniss Kandah has built that anyone can use right now — apps, APIs, models and datasets."
>
  <div class="page">
    <PageHeader
      eyebrow="Use these"
      title="Tools"
      meta={[`${tools.length} ${tools.length === 1 ? 'tool' : 'tools'}`, 'links verified 2026-08']}
    />

    <section class="section">
      <div class="section-head">
        <h2 class="label">Everything</h2>
        <p class="meta">newest first</p>
      </div>

      {
        tools.length === 0 ? (
          <p class="text-ink-muted">First tool coming soon.</p>
        ) : (
          <ul class="grid gap-4 sm:grid-cols-2">
            {tools.map((tool) => (
              <li class="panel flex flex-col gap-3">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <h3 class="row-title min-w-0 text-base">{tool.data.title}</h3>
                  <p class="label">{STATUS_NOTE[tool.data.tool!.status] ?? tool.data.tool!.status}</p>
                </div>

                <p class="row-desc">{tool.data.tool!.tagline}</p>

                <ul class="tag-row">
                  {tool.data.tags.map((tag) => (
                    <li>
                      <Tag>{tag}</Tag>
                    </li>
                  ))}
                </ul>

                <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-1">
                  {tool.data.tool!.internal ? (
                    <a class="btn" href={tool.data.tool!.url}>
                      Open
                    </a>
                  ) : (
                    <ExternalLink class="btn" href={tool.data.tool!.url}>
                      Open
                    </ExternalLink>
                  )}
                  <a class="meta link-quiet" href={`/projects/${tool.id}/`}>
                    How it was built &rarr;
                  </a>
                </div>
              </li>
            ))}
          </ul>
        )
      }

      <p class="meta mt-6 max-w-text leading-relaxed">
        New tools will live here at youniss.dev/tools/&lt;name&gt;. The ones above are hosted
        elsewhere — on Vercel, Netlify, GitHub Pages or Hugging Face — and open in a new tab.
      </p>
    </section>
  </div>
</BaseLayout>
