---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import PostRow from '../_PostRow.astro';
import { getPosts, tagSlug, type Post } from '../_post-utils';

export async function getStaticPaths() {
  const posts = await getPosts();

  // slug -> { label, posts }. The label is the first spelling encountered, so
  // two tags that slugify the same still land on one page.
  const bySlug = new Map<string, { label: string; posts: Post[] }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      if (!slug) continue;
      const bucket = bySlug.get(slug) ?? { label: tag, posts: [] };
      if (!bucket.posts.includes(post)) bucket.posts.push(post);
      bySlug.set(slug, bucket);
    }
  }

  /* A tag page with one post used to be a heading, one row, and then a footer
     that was 45% of the document. Every page now carries the neighbouring tags
     and the rest of the writing, so a narrow slice still leads somewhere. */
  const allTags = [...bySlug.entries()]
    .map(([slug, v]) => ({ slug, label: v.label, count: v.posts.length }))
    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

  return [...bySlug.entries()].map(([slug, { label, posts: tagged }]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: tagged,
      related: allTags.filter((t) => t.slug !== slug).slice(0, 12),
      others: posts.filter((post) => !tagged.includes(post)).slice(0, 4),
    },
  }));
}

interface Props {
  label: string;
  posts: Post[];
  related: ReadonlyArray<{ slug: string; label: string; count: number }>;
  others: Post[];
}

const { tag: slug } = Astro.params;
const { label, posts, related, others } = Astro.props;
const count = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`;
---

<BaseLayout
  title={`Writing tagged “${label}”`}
  description={`Every post tagged ${label} — ${count}.`}
>
  <div class="page">
    <PageHeader eyebrow="Writing · tag" title={label} meta={[count]}>
      <Fragment slot="actions">
        <a class="btn" href="/writing/">All writing</a>
      </Fragment>
    </PageHeader>

    <section class="section" aria-label={`Posts tagged ${label}`}>
      <ul class="row-list">
        {posts.map((post) => <PostRow post={post} activeTagSlug={slug} />)}
      </ul>
    </section>

    {
      related.length > 0 && (
        <section class="section">
          <div class="section-head">
            <h2 class="label">Other tags</h2>
          </div>
          <ul class="tag-row mt-4">
            {related.map((t) => (
              <li>
                <a class="tag" href={`/writing/tags/${t.slug}/`}>
                  {t.label} {t.count}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      others.length > 0 && (
        <section class="section">
          <div class="section-head">
            <h2 class="label">More writing</h2>
            <a class="meta link-quiet" href="/writing/">All posts</a>
          </div>
          <ul class="row-list mt-4">
            {others.map((post) => <PostRow post={post} />)}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
