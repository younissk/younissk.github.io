---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostRow from './_PostRow.astro';
import { getPosts } from './_post-utils';
import { RSS_PATH } from '../../consts';

const posts = await getPosts();

const years = posts.map((post) => post.data.date.getUTCFullYear());
const oldest = Math.min(...years);
const newest = Math.max(...years);
const span = oldest === newest ? `${newest}` : `${oldest} – ${newest}`;

const meta = posts.length
  ? [`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`, span]
  : [];
---

<BaseLayout
  title="Writing"
  description="Notes and workshop write-ups on web fundamentals, logic and applied AI — written by hand, not generated."
>
  <div class="page">
    <PageHeader
      eyebrow="Writing"
      title="Writing"
      description="Notes and workshop write-ups, written by hand. The old blog's machine-generated posts did not make the move."
      meta={meta}
    >
      <Fragment slot="actions">
        <a class="btn" href={RSS_PATH}>RSS</a>
      </Fragment>
    </PageHeader>

    <section class="section" aria-label="All posts">
      <ul class="row-list">
        {posts.map((post) => <PostRow post={post} />)}
      </ul>
    </section>
  </div>
</BaseLayout>
