---
/**
 * Posts.
 *
 * Linked from every post and every tag page, and from the RSS channel link.
 * All of those were 404s until this file existed.
 *
 * Rows come from _PostRow so this page and the tag pages stay identical. It
 * used to carry its own copy of the markup, which then did not match when the
 * row became a grid.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostRow from './_PostRow.astro';
import { getPosts } from './_post-utils';
import { RSS_PATH } from '../../consts';

const posts = await getPosts();
---

<BaseLayout
  title="Writing"
  description={`${posts.length} posts on fine-tuning, propositional logic and frontend work, including a tool-calling fine-tune that lost to the base model.`}
>
  <div class="page">
    <PageHeader eyebrow="Posts" title="Writing" meta={[`${posts.length} posts`]} />

    <section class="section">
      <ul class="row-list">
        {posts.map((post) => <PostRow post={post} />)}
      </ul>

      <p class="meta mt-6">
        <a class="link" href={RSS_PATH}>RSS</a>.
      </p>
    </section>
  </div>
</BaseLayout>
