---
/**
 * One row in a list of posts. Used by the writing index and by every tag page,
 * so both read identically.
 *
 * Underscore-prefixed: Astro skips it when building routes.
 *
 * The row is a `.row` containing a direct-child `<a>` (which drives the
 * full-bleed hover fill) plus a sibling tag list — the tags are links, and a
 * link cannot nest inside a link.
 */
import Tag from '../../components/Tag.astro';
import Mark from '../../components/Mark.astro';
import { readingTimeLabel } from './_reading-time';
import { isoDate, languageName, shortDate, tagSlug, type Post } from './_post-utils';

interface Props {
  post: Post;
  /** Heading level for the title — h2 in a flat list under the page h1. */
  headingLevel?: 'h2' | 'h3';
  /** Slug of the tag being filtered on, so its chip renders as active. */
  activeTagSlug?: string;
}

const { post, headingLevel: Heading = 'h2', activeTagSlug } = Astro.props;
const { title, description, date, tags, lang, hero } = post.data;
const href = `/writing/${post.id}/`;
---

<li class="row">
  {/* The post's own hero where it has one, otherwise the generated mark. */}
  <span class="row-media">
    {hero ? (
      <img src={hero} alt="" width="320" height="180" loading="lazy" decoding="async" />
    ) : (
      <Mark seed={href} kind="post" />
    )}
  </span>

  <div class="row-main">
    <a class="block" href={href}>
      <span class="kind" data-kind="post">post</span>
      <Heading class="row-title mt-1">{title}</Heading>
      <p class="row-desc mt-1.5">{description}</p>
    </a>

    {
      tags.length > 0 && (
        <ul class="tag-row mt-2.5">
          {tags.map((tag) => (
            <li>
              <Tag
                href={`/writing/tags/${tagSlug(tag)}/`}
                active={tagSlug(tag) === activeTagSlug}
              >
                {tag}
              </Tag>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <p class="row-rail">
    <time datetime={isoDate(date)}>{shortDate(date)}</time>
    <span>{readingTimeLabel(post.body)}</span>
    {lang !== 'en' && <span lang={lang}>{languageName(lang)}</span>}
  </p>
</li>
