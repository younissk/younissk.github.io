# Copy to .env and fill in. Everything here is optional: without it the site
# still builds — scripts/sync-youtube.ts logs a line and exits 0.

# YouTube Data API v3 key.
# Google Cloud console → APIs & Services → Credentials → Create API key, with
# the "YouTube Data API v3" enabled on the same project. Restrict it to that API.
YT_API_KEY=

# The channel id, not the @handle. It starts with "UC".
# Find it at youtube.com → your channel → Settings → Advanced settings, or in
# the page source of the channel URL.
YT_CHANNEL_ID=
